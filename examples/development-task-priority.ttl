t:report a code:ImpactAnalysisEntity ; rdfs:label "演示测试报告位置" .
t:evidence a dev:Evidence ; rdfs:label "演示测试证据" ; dev:generatedBy t:testRun ; dev:evaluatesSnapshot t:after ; dev:evaluatesModel t:model ;
