t:desiredGraph a dev:GraphRevision ; rdfs:label "目标设计图" ; dev:version "1" ; dev:source "fixture:design" ;
    dev:graphRole "Knowledge" ; dev:graphSpace "Desired" ; dev:inModel t:model ; dev:containsEntity t:design .
t:actualGraph a dev:GraphRevision ; rdfs:label "演示实际代码图" ; dev:version "1" ; dev:source "fixture:scan" ;
