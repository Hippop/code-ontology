@prefix code: <https://example.org/code-ontology#> .
@prefix biz:  <https://example.org/code-ontology/business#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/code-ontology/business>
    a owl:Ontology ;
    owl:imports <https://example.org/code-ontology> ;
    rdfs:label "Business semantic and code linkage ontology"@en ;
    rdfs:label "业务语义与代码图关联本体"@zh .

#################################################################
# Business classes
#################################################################

biz:BusinessEntity a owl:Class ;
    rdfs:subClassOf code:ImpactAnalysisEntity .

biz:BusinessDomain a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:BusinessCapability a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:Actor a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:UseCase a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:BusinessProcess a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:BusinessProcessStep a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:BusinessObject a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:BusinessAttribute a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:BusinessRule a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:ValidationRule a owl:Class ;
    rdfs:subClassOf biz:BusinessRule .

biz:AuthorizationRule a owl:Class ;
    rdfs:subClassOf biz:BusinessRule .

biz:StateTransitionRule a owl:Class ;
    rdfs:subClassOf biz:BusinessRule .

biz:ConsistencyRule a owl:Class ;
    rdfs:subClassOf biz:BusinessRule .

biz:RoutingRule a owl:Class ;
    rdfs:subClassOf biz:BusinessRule .

biz:CompensationRule a owl:Class ;
    rdfs:subClassOf biz:BusinessRule .

biz:BusinessEvent a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:BusinessState a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:StateTransition a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:AcceptanceCriterion a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:Requirement a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity ;
    rdfs:label "业务需求"@zh ;
    rdfs:comment "业务规划所描述的需求，具有业务 canonicalId；不自动等同于具有工程所有权约束的 eng:EngineeringRequirement 或 dev:Requirement。"@zh .

biz:ServiceLevelObjective a owl:Class ;
    rdfs:subClassOf biz:BusinessEntity .

biz:ImplementationSlice a owl:Class ;
    rdfs:subClassOf code:ImpactAnalysisEntity .

biz:BusinessMapping a owl:Class ;
    rdfs:subClassOf code:ImpactAnalysisEntity .

biz:CandidateMapping a owl:Class ;
    rdfs:subClassOf biz:BusinessMapping .

biz:ConfirmedMapping a owl:Class ;
    rdfs:subClassOf biz:BusinessMapping .

biz:BrokenMapping a owl:Class ;
    rdfs:subClassOf biz:BusinessMapping .

#################################################################
# Business structure relations
#################################################################

biz:containsCapability a owl:ObjectProperty ;
    rdfs:domain biz:BusinessDomain ;
    rdfs:range biz:BusinessCapability ;
    owl:inverseOf biz:belongsToDomain .

biz:belongsToDomain a owl:ObjectProperty ;
    rdfs:domain biz:BusinessCapability ;
    rdfs:range biz:BusinessDomain .

biz:containsUseCase a owl:ObjectProperty ;
    rdfs:domain biz:BusinessCapability ;
    rdfs:range biz:UseCase ;
    owl:inverseOf biz:belongsToCapability .

biz:belongsToCapability a owl:ObjectProperty ;
    rdfs:range biz:BusinessCapability .

biz:performsUseCase a owl:ObjectProperty ;
    rdfs:domain biz:Actor ;
    rdfs:range biz:UseCase .

biz:includesProcess a owl:ObjectProperty ;
    rdfs:domain biz:UseCase ;
    rdfs:range biz:BusinessProcess ;
    owl:inverseOf biz:belongsToUseCase .

biz:belongsToUseCase a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcess ;
    rdfs:range biz:UseCase .

biz:containsStep a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcess ;
    rdfs:range biz:BusinessProcessStep ;
    owl:inverseOf biz:belongsToProcess .

biz:belongsToProcess a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessProcess .

biz:hasEntryStep a owl:ObjectProperty ;
    rdfs:subPropertyOf biz:containsStep ;
    rdfs:domain biz:BusinessProcess ;
    rdfs:range biz:BusinessProcessStep .

biz:hasExitStep a owl:ObjectProperty ;
    rdfs:subPropertyOf biz:containsStep ;
    rdfs:domain biz:BusinessProcess ;
    rdfs:range biz:BusinessProcessStep .

biz:precedes a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessProcessStep ;
    owl:inverseOf biz:follows .

biz:follows a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessProcessStep .

biz:branchesTo a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessProcessStep .

biz:compensatedBy a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessProcessStep .

#################################################################
# Objects, rules, events and states
#################################################################

biz:hasBusinessAttribute a owl:ObjectProperty ;
    rdfs:domain biz:BusinessObject ;
    rdfs:range biz:BusinessAttribute ;
    owl:inverseOf biz:attributeOfBusinessObject .

biz:attributeOfBusinessObject a owl:ObjectProperty ;
    rdfs:domain biz:BusinessAttribute ;
    rdfs:range biz:BusinessObject .

biz:hasBusinessInput a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessObject .

biz:hasBusinessOutput a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessObject .

biz:governedBy a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessRule ;
    owl:inverseOf biz:governsStep .

biz:governsStep a owl:ObjectProperty ;
    rdfs:domain biz:BusinessRule ;
    rdfs:range biz:BusinessProcessStep .

biz:constrainsBusinessObject a owl:ObjectProperty ;
    rdfs:domain biz:BusinessRule ;
    rdfs:range biz:BusinessObject .

biz:constrainsBusinessAttribute a owl:ObjectProperty ;
    rdfs:domain biz:BusinessRule ;
    rdfs:range biz:BusinessAttribute .

biz:producesBusinessEvent a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:BusinessEvent .

biz:triggeredByBusinessEvent a owl:ObjectProperty ;
    rdfs:range biz:BusinessEvent .

biz:fromState a owl:ObjectProperty ;
    rdfs:domain biz:StateTransition ;
    rdfs:range biz:BusinessState .

biz:toState a owl:ObjectProperty ;
    rdfs:domain biz:StateTransition ;
    rdfs:range biz:BusinessState .

biz:performedByStep a owl:ObjectProperty ;
    rdfs:domain biz:StateTransition ;
    rdfs:range biz:BusinessProcessStep .

biz:guardedBy a owl:ObjectProperty ;
    rdfs:domain biz:StateTransition ;
    rdfs:range biz:BusinessRule .

biz:transitionsState a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:StateTransition .

biz:hasAcceptanceCriterion a owl:ObjectProperty ;
    rdfs:domain code:Requirement ;
    rdfs:range biz:AcceptanceCriterion .

biz:satisfiesAcceptanceCriterion a owl:ObjectProperty ;
    rdfs:range biz:AcceptanceCriterion .

#################################################################
# Business-to-code bridge relations
#################################################################

biz:realizesUseCase a owl:ObjectProperty ;
    rdfs:domain code:ImpactAnalysisEntity ;
    rdfs:range biz:UseCase ;
    owl:inverseOf biz:isRealizedBy .

biz:isRealizedBy a owl:ObjectProperty ;
    rdfs:domain biz:UseCase ;
    rdfs:range code:ImpactAnalysisEntity .

biz:implementsProcessStep a owl:ObjectProperty ;
    rdfs:domain biz:ImplementationSlice ;
    rdfs:range biz:BusinessProcessStep ;
    owl:inverseOf biz:isImplementedBySlice .

biz:isImplementedBySlice a owl:ObjectProperty ;
    rdfs:domain biz:BusinessProcessStep ;
    rdfs:range biz:ImplementationSlice .

biz:primaryImplementsStep a owl:ObjectProperty ;
    rdfs:domain code:CodeEntity ;
    rdfs:range biz:BusinessProcessStep .

biz:supportsStep a owl:ObjectProperty ;
    rdfs:domain code:ImpactAnalysisEntity ;
    rdfs:range biz:BusinessProcessStep .

biz:hasPrimaryEntry a owl:ObjectProperty ;
    rdfs:domain biz:ImplementationSlice ;
    rdfs:range code:ImpactAnalysisEntity .

biz:containsSupportingEntity a owl:ObjectProperty ;
    rdfs:domain biz:ImplementationSlice ;
    rdfs:range code:ImpactAnalysisEntity .

biz:enforcesRule a owl:ObjectProperty ;
    rdfs:domain code:ImpactAnalysisEntity ;
    rdfs:range biz:BusinessRule ;
    owl:inverseOf biz:isEnforcedBy .

biz:isEnforcedBy a owl:ObjectProperty ;
    rdfs:domain biz:BusinessRule ;
    rdfs:range code:ImpactAnalysisEntity .

biz:configuresRule a owl:ObjectProperty ;
    rdfs:domain code:ConfigurationKey ;
    rdfs:range biz:BusinessRule .

biz:representsBusinessObject a owl:ObjectProperty ;
    rdfs:domain code:ImpactAnalysisEntity ;
    rdfs:range biz:BusinessObject .

biz:representsBusinessAttribute a owl:ObjectProperty ;
    rdfs:domain code:ImpactAnalysisEntity ;
    rdfs:range biz:BusinessAttribute .

biz:storesBusinessObject a owl:ObjectProperty ;
    rdfs:domain code:DataEntity ;
    rdfs:range biz:BusinessObject .

biz:storesBusinessAttribute a owl:ObjectProperty ;
    rdfs:domain code:DataEntity ;
    rdfs:range biz:BusinessAttribute .

biz:representsBusinessEvent a owl:ObjectProperty ;
    rdfs:domain code:ContractEntity ;
    rdfs:range biz:BusinessEvent .

biz:verifiesBusinessEntity a owl:ObjectProperty ;
    rdfs:subPropertyOf code:verifies ;
    rdfs:domain code:TestCase ;
    rdfs:range biz:BusinessEntity .

biz:runsInDeployableUnit a owl:ObjectProperty ;
    rdfs:domain biz:ImplementationSlice ;
    rdfs:range code:DeployableUnit .

#################################################################
# Mapping reification
#################################################################

biz:mappingBusinessEntity a owl:ObjectProperty ;
    rdfs:domain biz:BusinessMapping ;
    rdfs:range biz:BusinessEntity .

biz:mappingTechnicalEntity a owl:ObjectProperty ;
    rdfs:domain biz:BusinessMapping ;
    rdfs:range code:ImpactAnalysisEntity .

biz:mappingRelation a owl:ObjectProperty ;
    rdfs:domain biz:BusinessMapping ;
    rdfs:range rdf:Property .

biz:supportedByEvidence a owl:ObjectProperty ;
    rdfs:domain biz:BusinessMapping ;
    rdfs:range code:ImpactEvidence .

biz:confidence a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

biz:canonicalId a owl:DatatypeProperty ;
    rdfs:range xsd:string .

biz:reviewStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string .

biz:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

biz:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

biz:lastVerifiedCommit a owl:DatatypeProperty ;
    rdfs:range xsd:string .

# Human-readable class definitions; identity and inheritance above remain authoritative.
biz:BusinessEntity rdfs:label "业务实体"@zh ; rdfs:comment "具有稳定业务标识的语义对象；不等同于代码符号或数据库记录。"@zh .
biz:BusinessDomain rdfs:label "业务领域"@zh ; rdfs:comment "组织业务能力、业务对象和规则的语义范围。"@zh .
biz:BusinessCapability rdfs:label "业务能力"@zh ; rdfs:comment "业务持续提供的能力；与 code:BusinessCapability 保持独立身份。"@zh .
biz:Actor rdfs:label "业务参与者"@zh ; rdfs:comment "在业务用例中承担角色的人或外部系统。"@zh .
biz:UseCase rdfs:label "业务用例"@zh ; rdfs:comment "参与者为达成业务目标而使用系统的场景，关联能力与流程。"@zh .
biz:BusinessProcess rdfs:label "业务流程"@zh ; rdfs:comment "组织一组业务步骤及入口、出口的过程定义。"@zh .
biz:BusinessProcessStep rdfs:label "业务步骤"@zh ; rdfs:comment "可独立关联规则和实现切片的业务过程单元，不是代码调用。"@zh .
biz:BusinessObject rdfs:label "业务对象"@zh ; rdfs:comment "业务领域中独立表达的对象概念，可具有多个技术表示。"@zh .
biz:BusinessAttribute rdfs:label "业务属性"@zh ; rdfs:comment "业务对象的语义属性；API 字段、语言字段和数据库列是其不同技术表示。"@zh .
biz:BusinessRule rdfs:label "业务规则"@zh ; rdfs:comment "业务允许、禁止或必须满足的规则，不由代码类型自动证明。"@zh .
biz:ValidationRule rdfs:label "业务校验规则"@zh ; rdfs:comment "约束业务输入或对象有效性的规则。"@zh .
biz:AuthorizationRule rdfs:label "业务授权规则"@zh ; rdfs:comment "描述参与者在业务范围内允许执行的操作，不自动实现权限控制。"@zh .
biz:StateTransitionRule rdfs:label "状态迁移规则"@zh ; rdfs:comment "约束业务对象从一种状态迁移到另一种状态的规则。"@zh .
biz:ConsistencyRule rdfs:label "业务一致性规则"@zh ; rdfs:comment "要求多个业务数据或对象之间保持一致的规则。"@zh .
biz:RoutingRule rdfs:label "业务路由规则"@zh ; rdfs:comment "决定业务处理路径或目标的规则。"@zh .
biz:CompensationRule rdfs:label "业务补偿规则"@zh ; rdfs:comment "描述失败后补偿要求的规则，不代表补偿已执行。"@zh .
biz:BusinessEvent rdfs:label "业务事件"@zh ; rdfs:comment "具有业务意义的发生事实或事件语义，不等于消息主题。"@zh .
biz:BusinessState rdfs:label "业务状态"@zh ; rdfs:comment "业务对象在指定流程中可处于的状态。"@zh .
biz:StateTransition rdfs:label "业务状态迁移"@zh ; rdfs:comment "具有明确源状态与目标状态的迁移定义，可关联事件、步骤和守卫规则。"@zh .
biz:AcceptanceCriterion rdfs:label "业务验收条件"@zh ; rdfs:comment "业务侧的验收判据，与 code/dev 验收类型通过明确映射关联。"@zh .
biz:ServiceLevelObjective rdfs:label "服务水平目标"@zh ; rdfs:comment "业务或服务在声明范围内应达到的质量目标。"@zh .
biz:ImplementationSlice rdfs:label "业务实现切片"@zh ; rdfs:comment "一个主要业务步骤的技术入口与支持对象集合。"@zh .
biz:BusinessMapping rdfs:label "业务技术映射"@zh ; rdfs:comment "关联业务实体与技术实体的映射记录，保留置信度和证据。"@zh .
biz:CandidateMapping rdfs:label "候选业务映射"@zh ; rdfs:comment "尚待确认的业务技术对应关系，不代表已验证实现。"@zh .
biz:ConfirmedMapping rdfs:label "已确认业务映射"@zh ; rdfs:comment "记录最近验证提交的业务技术映射，不直接推出验收满足。"@zh .
biz:BrokenMapping rdfs:label "失效业务映射"@zh ; rdfs:comment "原关联依据不再成立、需要复核或修复的映射。"@zh .
