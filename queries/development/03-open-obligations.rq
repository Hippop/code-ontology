# Q3: what work is missing, and what semantic change caused it?
PREFIX dev: <https://example.org/code-ontology/development#>
SELECT DISTINCT ?plan ?obligation ?state ?target ?delta ?task WHERE {
  ?plan dev:hasObligation ?obligation .
  ?obligation dev:status ?state ; dev:addresses ?target ; dev:causedBy ?delta .
  FILTER(?state IN ("Open", "InProgress"))
  OPTIONAL { ?plan dev:hasTask ?task . ?task dev:fulfills ?obligation }
}
ORDER BY ?plan ?obligation
